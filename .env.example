DJANGO_SECRET_KEY=
DEBUG=True   # set to False in production
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL=   # overrides POSTGRES_* when set (Render provides this automatically)

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Supabase Storage
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # optional, used server-side to bypass RLS

# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Vercel preview domains vary by deployment; add extra origin regexes as needed.
CORS_ALLOWED_ORIGIN_REGEXES=^https://([a-z0-9-]+\.)*vercel\.app$

# Optional: computer LAN IP for access from a phone on the same network
LAN_HOST=
